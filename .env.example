# Скопируйте в .env в корне репо. Его читают и локальный запуск бэкенда, и Docker Compose.
# Обязателен только LLM_API_KEY, остальное работает со значениями по умолчанию.

# --- Агент
# Ключ OpenRouter: https://openrouter.ai/settings/keys
LLM_API_KEY=
# Любой OpenAI-совместимый провайдер; по умолчанию OpenRouter.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Чат-агент: диалог, уточнения, инструменты.
# CHAT_MODEL=anthropic/claude-haiku-5.5
# Дизайн-агент: JSON баннера и промо-экрана, тексты.
# DESIGN_MODEL=anthropic/claude-sonnet-5.5
# Генерация картинок; пустое значение выключает генерацию.
# IMAGE_MODEL=openai/gpt-image-2.5-sunburst
# Фон-паттерн в SVG: тема передаётся цветом. Он же запасной вариант, если иллюстрация не сгенерировалась.
# PATTERN_MODEL=anthropic/claude-haiku-5.5
# Какие картинки делает агент: mixed — фон баннера паттерном, промо-экран иллюстрацией; ask — спрашивает кнопками;
# pattern — только фоны-паттерны; illustration — только иллюстрации.
# IMAGE_MODE=illustration
# Загрузка фото менеджером: лимит на файл и на все загрузки, байты.
# MEDIA_UPLOAD_MAX_BYTES=5242880
# MEDIA_UPLOAD_MAX_TOTAL_BYTES=314572800
# LLM_TIMEOUT_SECONDS=90
# Провайдеры OpenRouter по приоритету, через запятую: кеш промпта работает, только пока запросы идут к одному.
# Пустое значение отдаёт выбор OpenRouter.
# LLM_PROVIDERS=anthropic
# Кеш промпта Anthropic (cache_control). Выключите для провайдера, который его не понимает.
# LLM_PROMPT_CACHE=true
# Распознавание речи для кнопки микрофона, ключ тот же. Пустое значение выключает диктовку.
# STT_MODEL=openai/whisper-large-v3
# STT_LANGUAGE=ru
# STT_MAX_AUDIO_BYTES=5242880
# Legacy: озвучка запасного голосового режима, ключ тот же. Модель должна отдавать MP3; пустое значение выключает озвучку.
# TTS_MODEL=elevenlabs/eleven-flash-v2.5
# TTS_VOICE=sarah
# TTS_MAX_CHARS=1000
# SPEECH_TIMEOUT_SECONDS=30
# Основной голосовой режим — GPT-Live: прямой ключ OpenAI платного тарифа, OpenRouter эту модель не отдаёт.
# Без ключа работает запасная legacy-схема: ход по нажатию, Whisper, агент, озвучка.
# OPENAI_API_KEY=
# LIVE_MODEL=gpt-live-1
# Имя встроенного голоса или voice_… из python -m app.create_live_voice: среди встроенных нет русских.
# LIVE_VOICE=marin
# Голосовой режим на фронтенде включён по умолчанию; false убирает кнопку «Голосом». Читается при сборке, задаётся в frontend/.env.local.
# VITE_VOICE_MODE=false
# legacy включает ход по нажатию, даже если GPT-Live настроен.
# VITE_VOICE_ENGINE=legacy
# Адрес API кампаний, в который ходит агент.
# CAMPAIGNS_API_URL=http://localhost:8000

# --- Бэкенд
# Postgres, Redis и S3 поднимает docker compose (db, redis, s3). Для локального запуска вне Docker значения ниже
# уже подходят: `docker compose up -d db redis s3`, затем `make migrate` и `make run`.
# DATABASE_URL=postgresql+asyncpg://adpilot:adpilot@localhost:5432/adpilot
# REDIS_URL=redis://localhost:6379/0
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=rustfsadmin
# STORAGE_SECRET_KEY=rustfsadmin
# STORAGE_BUCKET=adpilot-media
# В проде бакет создаёт инфраструктура; в dev приложение создаёт его само.
# STORAGE_AUTO_CREATE_BUCKET=true
# Префикс ссылок на картинки, которые раздаёт бэкенд (GET /media/...); валидатор баннера принимает его наравне с https.
# MEDIA_BASE_URL=/api/media
# Разрешённые источники CORS, JSON-список. Через прокси фронтенда CORS не нужен.
# CORS_ORIGINS=["http://localhost:5173"]
# Уровень и формат логов; X-Request-ID связывает ответ с записью в логе.
# LOG_LEVEL=INFO
# LOG_JSON=false

# --- Авторизация
# Ключи RS256 создаёт `make keys` (backend/secrets). В проде их можно задать значением: JWT_PRIVATE_KEY, JWT_PUBLIC_KEY.
# JWT_PRIVATE_KEY_PATH=backend/secrets/jwt_private_key.pem
# JWT_PUBLIC_KEY_PATH=backend/secrets/jwt_public_key.pem
# ACCESS_TTL=900
# REFRESH_TTL=2592000
# Ключ CSRF для веб-клиента. В prod значение по умолчанию запрещено.
# CSRF_HMAC_KEY=change-me
# Открытая регистрация создаёт менеджера. Модераторов и админов заводит `make admin` или админ через API.
# REGISTRATION_ENABLED=true
# Cookie с refresh-токеном видна браузеру под путём прокси фронтенда.
# REFRESH_COOKIE_PATH=/api/auth
# COOKIE_SECURE=false
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Демо-стенд: менеджер ivanov.p@example.com и модератор petrova.m@example.com с этим паролем плюс демо-кампании из кейса.
# В docker compose по умолчанию adpilot-demo; в prod задавать нельзя.
# DEMO_USERS_PASSWORD=adpilot-demo

# --- Уведомления (доставляет воркер через outbox: отправка на модерацию, решение модератора, запуск)
# NOTIFICATIONS_PROVIDER=log
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
