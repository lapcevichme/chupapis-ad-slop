# Скопируйте в .env. Все переменные необязательны: без них работают значения по умолчанию.

# БД бэкенда. В Docker Compose задаётся в docker-compose.yml.
# DATABASE_URL=sqlite:///./data/adpilot.db

# Адрес, с которого бэкенд раздаёт картинки; ссылки с этим префиксом валидатор баннера принимает наравне с https.
# MEDIA_BASE_URL=/api/media

# Разрешённые источники CORS, JSON-список.
# CORS_ORIGINS=["http://localhost:5173"]
