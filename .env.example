# Скопируйте в .env в корне репо. Его читают и локальный запуск бэкенда, и Docker Compose.
# Обязателен только LLM_API_KEY, остальное работает со значениями по умолчанию.

# --- Агент
# Ключ OpenRouter: https://openrouter.ai/settings/keys
LLM_API_KEY=
# Любой OpenAI-совместимый провайдер; по умолчанию OpenRouter.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Чат-агент: диалог, уточнения, инструменты.
# CHAT_MODEL=anthropic/claude-haiku-5.5
# Дизайн-агент: JSON баннера и промо-экрана, тексты.
# DESIGN_MODEL=anthropic/claude-sonnet-5.5
# Генерация картинок; пустое значение выключает генерацию.
# IMAGE_MODEL=openai/gpt-image-2.5-sunburst
# Фон-паттерн в SVG: тема передаётся цветом. Он же запасной вариант, если иллюстрация не сгенерировалась.
# PATTERN_MODEL=anthropic/claude-haiku-5.5
# Какие картинки делает агент: mixed — фон баннера паттерном, промо-экран иллюстрацией; ask — спрашивает кнопками;
# pattern — только фоны-паттерны; illustration — только иллюстрации.
# IMAGE_MODE=mixed
# LLM_TIMEOUT_SECONDS=90
# Провайдеры OpenRouter по приоритету, через запятую: кеш промпта работает, только пока запросы идут к одному.
# Пустое значение отдаёт выбор OpenRouter.
# LLM_PROVIDERS=anthropic
# Кеш промпта Anthropic (cache_control). Выключите для провайдера, который его не понимает.
# LLM_PROMPT_CACHE=true
# Распознавание речи для кнопки микрофона, ключ тот же. Пустое значение выключает диктовку.
# STT_MODEL=openai/whisper-large-v3
# STT_LANGUAGE=ru
# STT_MAX_AUDIO_BYTES=5242880
# Озвучка реплик, ключ тот же. Модель должна отдавать MP3; пустое значение выключает озвучку.
# TTS_MODEL=elevenlabs/eleven-flash-v2.5
# TTS_VOICE=sarah
# TTS_MAX_CHARS=1000
# SPEECH_TIMEOUT_SECONDS=30
# Адрес API кампаний, в который ходит агент.
# CAMPAIGNS_API_URL=http://localhost:8000

# --- Бэкенд
# БД бэкенда. В Docker Compose задаётся в docker-compose.yml.
# DATABASE_URL=sqlite:///./data/adpilot.db
# Файлы состояния диалогов и медиа (пути относительно backend/ при локальном запуске).
# CHECKPOINT_DB=./data/checkpoints.db
# MEDIA_DIR=./data/media
# SEED_DIR=./seed
# Префикс ссылок на картинки, которые раздаёт бэкенд; валидатор баннера принимает его наравне с https.
# MEDIA_BASE_URL=/api/media
# Разрешённые источники CORS, JSON-список.
# CORS_ORIGINS=["http://localhost:5173"]
# Уровень и формат логов; X-Request-ID связывает ответ с записью в логе.
# LOG_LEVEL=INFO
# LOG_JSON=false
